<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<OutputType>Exe</OutputType>
		<Deterministic>true</Deterministic>
		<IsPackable>false</IsPackable>
		<LangVersion>13.0</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>PCL.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TUnit" Version="1.43.38" />
		<PackageReference Include="PolySharp" Version="1.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- 对照测试用：主程序已不引用 Microsoft.VisualBasic，这里引用它只是为了证明 Coerce 的行为与其一致 -->
	<ItemGroup>
		<Reference Include="Microsoft.VisualBasic" />
	</ItemGroup>

	<!-- 直接编译主程序中不依赖界面的源文件 -->
	<ItemGroup>
		<Compile Include="..\Plain Craft Launcher 2\Modules\Base\Coerce.cs" Link="Linked\Coerce.cs" />
	</ItemGroup>

</Project>
