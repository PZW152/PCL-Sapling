<Project Sdk="Microsoft.NET.Sdk">

  <!-- PCL 主程序：C# + WPF，運行於 Windows 自帶的 .NET Framework 4.8。
       輸出單個 exe：依賴庫內嵌於資源，啟動時由 Application.xaml.cs 的 AssemblyResolve 從記憶體加載。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>PCL</RootNamespace>
    <AssemblyName>Plain Craft Launcher 2</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Configurations>Debug;Release;Snapshot</Configurations>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutDir>bin\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- 不讓 SDK 按配置名自動添加 DEBUG/RELEASE 等符號，版本類型完全由下方配置決定 -->
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;CS4014;CS8981</NoWarn>
  </PropertyGroup>

  <!-- 與原 VB 項目一致：Debug 與 Snapshot 都編譯為快照版，Release 為正式版 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>SNAPSHOT</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Snapshot'">
    <DefineConstants>SNAPSHOT</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="Application.xaml" />
    <Page Include="**\*.xaml" Exclude="Application.xaml;Resources\Custom.xaml;Controls\MySliderDot.xaml;bin\**;obj\**" />
    <None Include="Resources\Custom.xaml;Controls\MySliderDot.xaml" />
  </ItemGroup>

