  <!-- 依賴庫與資源文件內嵌進 exe -->
  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx" LogicalName="PCL.Resources.resources" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Imazen.WebP"><HintPath>Resources\Imazen.WebP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>Resources\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ookii.Dialogs.Wpf"><HintPath>Resources\Ookii.Dialogs.Wpf.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ThrottleDebounce"><HintPath>Resources\ThrottleDebounce.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" Private="false" />
    <ProjectReference Include="..\MeloongCore\Wpf\MeloongCore.Wpf.csproj" Private="false" />
    <ProjectReference Include="..\PCLCS\PCLCS.csproj" Private="false" />
  </ItemGroup>

  <Import Project="..\BuildSecrets.local.props" Condition="Exists('..\BuildSecrets.local.props')" />

  <!-- 編譯時注入密鑰與提交號：從環境變量 PCL_MS_CLIENT_ID / PCL_CURSEFORGE_API_KEY / PCL_COMMIT_HASH 生成 BuildSecrets 類，不寫入源碼倉庫 -->
  <Target Name="GenerateBuildSecrets" BeforeTargets="CoreCompile;XamlPreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <BuildSecretsFile>$(IntermediateOutputPath)BuildSecrets.g.cs</BuildSecretsFile>
      <_MsClientId>$([System.Environment]::GetEnvironmentVariable('PCL_MS_CLIENT_ID'))</_MsClientId>
      <_CurseForgeKey>$([System.Environment]::GetEnvironmentVariable('PCL_CURSEFORGE_API_KEY'))</_CurseForgeKey>
      <_CommitHash>$([System.Environment]::GetEnvironmentVariable('PCL_COMMIT_HASH'))</_CommitHash>
      <!-- 環境變量未設置時，回退到倉庫根目錄的 BuildSecrets.local.props（已被 .gitignore 忽略） -->
      <_MsClientId Condition="'$(_MsClientId)' == ''">$(LocalMsClientId)</_MsClientId>
      <_CurseForgeKey Condition="'$(_CurseForgeKey)' == ''">$(LocalCurseForgeApiKey)</_CurseForgeKey>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildSecretsFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace PCL { internal static class BuildSecrets { public const string MsClientId = &quot;$(_MsClientId)&quot;%3B public const string CurseForgeApiKey = &quot;$(_CurseForgeKey)&quot;%3B public const string CommitHash = &quot;$(_CommitHash)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(BuildSecretsFile)" />
      <FileWrites Include="$(BuildSecretsFile)" />
    </ItemGroup>
  </Target>

</Project>
