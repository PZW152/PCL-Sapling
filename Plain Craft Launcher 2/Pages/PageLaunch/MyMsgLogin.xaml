                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="手机扫码打开登录页" FontSize="12" Foreground="{DynamicResource ColorBrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="4" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="150,0,8,0" Orientation="Horizontal">
                <local:MyButton ColorType="Normal" x:FieldModifier="public" Text="重新打开网页" x:Name="Btn1" Click="OnBtn1_Click" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False"
                             local:CustomEventService.EventType="打开网页" />
                <local:MyButton ColorType="Normal" x:FieldModifier="public" Text="复制代码" x:Name="Btn2" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False"
                             local:CustomEventService.EventType="复制文本" />
                <local:MyButton ColorType="Normal" x:FieldModifier="public" Text="取消" x:Name="Btn3" Click="OnBtn3_Click" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
